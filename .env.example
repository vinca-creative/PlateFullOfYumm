# These VITE_ variables are public and may be included in the browser build.
VITE_PUBLIC_SITE_ORIGIN=https://platefullofyum.com
VITE_CMS_ORIGIN=https://platefullofyum.com
# Advertising is disabled by default. Enabled builds fail unless every real public/legal value below validates.
VITE_ADS_ENABLED=false
# Owner/account-generated URL on fundingchoicesmessages.google.com with /i/pub-<publisher digits> path.
VITE_ADS_CMP_URL=
# Public AdSense publisher and manual slot IDs; never put credentials in VITE_ variables.
VITE_ADS_PUBLISHER_ID=
VITE_ADS_FIRST_SLOT=
# Optional real second slot; only eligible after the recipe on a long-form page.
VITE_ADS_SECOND_SLOT=
# Owner-approved public HTTPS privacy policy and exact Google DIRECT seller entry matching the publisher ID.
VITE_ADS_PRIVACY_URL=
VITE_ADS_SELLER_LINE=
# Public Cloudflare Turnstile site key; leave empty to disable guest submissions.
VITE_TURNSTILE_SITE_KEY=

# Public WordPress REST root used only during the build; no login credentials required.
PFOY_WORDPRESS_API_ROOT=https://platefullofyum.com/wp-json/
