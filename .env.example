# These VITE_ variables are public and may be included in the browser build.
VITE_PUBLIC_SITE_ORIGIN=https://platefullofyum.com
VITE_CMS_ORIGIN=https://platefullofyum.com
# Ads are unavailable until a certified CMP and verified publisher setup are implemented.
VITE_ADS_ENABLED=false
# Public Cloudflare Turnstile site key; leave empty to disable guest submissions.
VITE_TURNSTILE_SITE_KEY=

# Public WordPress REST root used only during the build; no login credentials required.
PFOY_WORDPRESS_API_ROOT=https://platefullofyum.com/wp-json/
